<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep oceanic teal-to-abyssal radial gradient base -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="48"
                android:centerY="40"
                android:gradientRadius="78"
                android:type="radial">
                <item android:offset="0.0" android:color="#00838F" />
                <item android:offset="0.52" android:color="#004D57" />
                <item android:offset="1.0" android:color="#001D23" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle top-right diagonal aqua sheen for depth -->
    <path
        android:pathData="M0,0 L108,0 L108,72 L36,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="88"
                android:startY="16"
                android:endX="42"
                android:endY="62"
                android:type="linear">
                <item android:offset="0.0" android:color="#284DD0E1" />
                <item android:offset="1.0" android:color="#004DD0E1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft concentric ripple rings inside safe zone -->
    <path
        android:pathData="M54,20A34,34 0 1,0 54,88A34,34 0 1,0 54,20Z"
        android:fillColor="#0D80DEEA" />

    <path
        android:pathData="M54,29A25,25 0 1,0 54,79A25,25 0 1,0 54,29Z"
        android:fillColor="#1480DEEA" />

</vector>
