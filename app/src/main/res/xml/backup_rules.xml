<full-backup-content>
    <!-- Exclude local link history database to uphold 100% on-device privacy guarantee -->
    <exclude domain="database" path="linkscrub.db" />
    <exclude domain="database" path="linkscrub.db-shm" />
    <exclude domain="database" path="linkscrub.db-wal" />
</full-backup-content>