<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local link history database from cloud backups to guarantee 100% on-device privacy -->
        <exclude domain="database" path="linkscrub.db" />
        <exclude domain="database" path="linkscrub.db-shm" />
        <exclude domain="database" path="linkscrub.db-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="linkscrub.db" />
    </device-transfer>
</data-extraction-rules>